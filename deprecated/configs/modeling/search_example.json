{
  "scenario": "configs/modeling/hicache_group_example.json",
  "target_template": "configs/modeling/hicache_target_example.json",
  "space": {
    "write_policy": ["write_through_selective", "write_back"],
    "prefetch_policy": ["wait_complete", "best_effort"],
    "prefetch_threshold_pages": [4, 8]
  },
  "objective": {"metric": "http_e2e_sec", "workload": "<selected-workload>"},
  "search": {"algorithm": "enumerate", "max_predictions": 9, "max_wall_sec": 1800},
  "execution": {"model_run_jobs": 1},
  "confirmation": {"enabled": false},
  "output_dir": "data/search_runs/my_search"
}
