{
  "framework": "sglang",
  "name": "qwen3-32b-hicache-tp2-smoke",
  "run_id": "manual_hicache_tp2_smoke",
  "env": {
    "ASCEND_VISIBLE_DEVICES": "0,1",
    "SGLANG_SET_CPU_AFFINITY": "1",
    "PYTORCH_NPU_ALLOC_CONF": "expandable_segments:True",
    "STREAMS_PER_DEVICE": "32",
    "HCCL_BUFFSIZE": "1536",
    "HCCL_OP_EXPANSION_MODE": "AIV",
    "PYTHONPATH": "/workspace/trace-sim/src/profiling/python_probe",
    "TRACE_SIM_PYTHON_PROBE": "1",
    "TRACE_SIM_PYTHON_PROBES": "sglang.hicache,sglang.kvcacheio",
    "TRACE_SIM_PYTHON_PROBE_OUTPUT": "/workspace/trace-sim/data/profile_runs/sglang/manual_hicache_tp2_smoke/trace/python_probe",
    "SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR": "/workspace/trace-sim/data/profile_runs/sglang/manual_hicache_tp2_smoke/hicache_file"
  },
  "hook": {
    "enabled": true,
    "library": "build/docker/sglang/lib/libhook.so",
    "trace_output": "trace/cpu_trace"
  },
  "server": {
    "ready_url": "http://127.0.0.1:30001/get_model_info",
    "ready_timeout_sec": 2400,
    "command": [
      "python3",
      "-m",
      "sglang.launch_server",
      "--model-path",
      "/models/Qwen3-32B",
      "--trust-remote-code",
      "--attention-backend",
      "ascend",
      "--device",
      "npu",
      "--tp-size",
      "2",
      "--mem-fraction-static",
      "0.6",
      "--context-length",
      "1024",
      "--page-size",
      "64",
      "--enable-hierarchical-cache",
      "--hicache-ratio",
      "1.2",
      "--enable-cache-report",
      "--hicache-storage-backend",
      "file",
      "--hicache-storage-prefetch-policy",
      "wait_complete",
      "--hicache-storage-backend-extra-config",
      "{\"hicache_storage_pass_prefix_keys\": true, \"prefetch_threshold\": 64}",
      "--disable-cuda-graph",
      "--host",
      "127.0.0.1",
      "--port",
      "30001",
      "--served-model-name",
      "Qwen3-32B"
    ]
  },
  "profile": {
    "enabled": true,
    "output_dir": "trace/torch",
    "activities": [
      "CPU",
      "GPU"
    ],
    "profile_by_stage": false,
    "with_stack": false,
    "record_shapes": false,
    "merge_profiles": false,
    "profile_prefix": "qwen3_32b_hicache_tp2_smoke",
    "stop_after_workload": true
  },
  "bench": {
    "command": "python3 - <<'PY'\nimport json\nimport time\nimport urllib.request\n\nurl = 'http://127.0.0.1:30001/generate'\nprompt = 'HiCache profile smoke shared prefix. ' * 64\nbody = {\n    'text': prompt,\n    'sampling_params': {\n        'max_new_tokens': 8,\n        'temperature': 0,\n        'ignore_eos': True\n    }\n}\nfor i in range(2):\n    req = urllib.request.Request(url, data=json.dumps(body).encode('utf-8'), headers={'Content-Type': 'application/json'}, method='POST')\n    with urllib.request.urlopen(req, timeout=600) as resp:\n        payload = resp.read().decode('utf-8', errors='replace')\n    print(f'request={i} status=ok bytes={len(payload)}')\n    time.sleep(1)\nPY"
  }
}
