{
  "name": "profiling_hicache_state_mainline_one_matrix",
  "framework": "sglang",
  "metadata": {
    "purpose": "Mainline-one HiCache state profiling suite with two server scenarios and two input workloads.",
    "manual_run_note": "Use --list-experiments first, then select one or more ids with --experiment or --experiments for manual profiling and archival.",
    "shared_profiling_note": "HiCache collection follows the token/range invariant contract: default state inputs are classified by fact_class, use token dictionary/span facts, and keep source movement as timing/source_actual observations outside state_model_input.",
    "model_path_note": "The current model path is /models/Qwen3-32B. Update server.model_path and server.command if the container mount changes.",
    "ld_preload_note": "LD_PRELOAD is disabled for this HiCache state suite; HiCache state facts are collected by Python probe."
  },
  "profiling": {
    "enabled": true,
    "channels": [
      "python_probe"
    ],
    "debug": false,
    "torch": {
      "enabled": false,
      "output_dir": "trace/torch",
      "with_stack": false,
      "record_shapes": false
    },
    "python_probe": {
      "probes": [
        "sglang.hicache"
      ],
      "state_trace": {
        "enabled": true
      },
      "targets": [
        {
          "id": "hiradix.request_tokens",
          "module": "sglang.srt.mem_cache.hiradix_cache",
          "target": "HiRadixCache.match_prefix",
          "events": [
            "hicache_request_tokens_start",
            "hicache_request_tokens_end"
          ],
          "fields": [
            {
              "name": "model_input",
              "source": "const:true"
            },
            {
              "name": "dag_input",
              "source": "const:false"
            },
            {
              "name": "state_model_input",
              "source": "const:true"
            },
            {
              "name": "fact_class",
              "source": "const:invariant_state"
            },
            {
              "name": "event_role",
              "source": "const:request_tokens"
            },
            {
              "name": "request_id",
              "source": "arg:params.req.rid",
              "required": false
            },
            {
              "name": "cache_scope",
              "source": "hicache_cache_scope:self"
            },
            {
              "name": "seq_no",
              "source": "hicache_seq:self"
            },
            {
              "name": "source_page_size",
              "source": "self.page_size"
            },
            {
              "name": "token_dictionary",
              "source": "token_path:arg:params.key,self"
            },
            {
              "name": "full_path_span",
              "source": "token_span:arg:params.key"
            },
            {
              "name": "token_count",
              "source": "len:arg:params.key"
            }
          ]
        },
        {
          "id": "hiradix.lookup_path",
          "module": "sglang.srt.mem_cache.hiradix_cache",
