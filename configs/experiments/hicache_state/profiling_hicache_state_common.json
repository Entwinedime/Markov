{
  "name": "profiling_hicache_state_common",
  "framework": "sglang",
  "continue_on_error": true,
  "metadata": {
    "purpose": "Common HiCache cache-state development suite with five target server configurations and four normally generated inputs. It records Python probe state facts without a forced-token contract.",
    "server_matrix_note": "Five server configs cover all active HiCache write policies and prefetch policies, Ascend-runnable page32/page64/page128 regimes, low/balanced capacity, different thresholds, and different timeout regimes.",
    "input_matrix_note": "Inputs are three manual phased workloads plus one bench_serving generated-shared-prefix workload. Runner expands the matrix to 20 experiments.",
    "profile_mode": "common",
    "model_path_note": "The current model path is /models/Qwen3-32B. Update server.model_path and server.command if the container mount changes."
  },
  "profiling": {
    "enabled": true,
    "channels": [
      "python_probe"
    ],
    "debug": false,
    "torch": {
      "enabled": false,
      "output_dir": "trace/torch",
      "with_stack": false,
      "record_shapes": false
    },
    "python_probe": {
      "name": "sglang.hicache",
      "consumers": [
        "hicache_state_model",
        "hicache_input_contract",
        "hicache_final_state_validator",
        "hicache_transition_validator",
        "hicache_dag_patch"
      ],
      "flush_every": 256
    },
    "ld_preload": {
      "enabled": false,
      "library": "build/docker/sglang/lib/libhook.so",
      "trace_output": "trace/ld_preload/cpu_trace.json"
    }
  },
  "env": {
    "SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR": "{run_dir}/hicache_storage"
  },
  "matrix": {
    "servers": [
      {
        "id": "c0_wt_timeout_p128_balanced",
