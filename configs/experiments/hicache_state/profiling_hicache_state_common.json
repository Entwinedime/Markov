            "{\"prefetch_threshold\":256,\"prefetch_timeout_base\":2.0,\"prefetch_timeout_per_ki_token\":0.25,\"prefetch_timeout_max\":4.0,\"hicache_storage_pass_prefix_keys\":true}"
