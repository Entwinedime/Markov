            "--hicache-mem-layout",
            "page_first_direct",
            "--hicache-storage-backend",
            "file",
            "--disable-cuda-graph",
            "--attention-backend",
            "ascend",
            "--sampling-backend",
            "ascend",
            "--enable-deterministic-inference",
            "--skip-server-warmup",
            "--random-seed",
            "20260623",
            "--page-size",
            "128",
            "--max-total-tokens",
            "8192",
            "--hicache-ratio",
            "2.0",
            "--hicache-write-policy",
            "write_through",
            "--hicache-storage-prefetch-policy",
            "timeout",
