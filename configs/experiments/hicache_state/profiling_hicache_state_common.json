          "model_path_note": "The current model path is /models/Qwen3-32B. Update server.model_path and server.command if the container mount changes.",
          "collection_note": "Common cache-state profiling with normal generation and Python probe state facts.",
          "hicache_config_signature": "page_size=128,l1_capacity_pages=64,l2_capacity_pages=129,write_policy=write_through,prefetch_policy=timeout,hicache_ratio=2.0,prefetch_threshold_tokens=256,prefetch_timeout=2.0/0.25/4.0",
          "hicache_coverage": "The five-server matrix jointly covers write_through, write_through_selective, write_back, wait_complete, best_effort, timeout, multiple page sizes, and multiple capacity/threshold regimes.",
          "hicache_write_policy": "write_through"
        },
        "server": {
          "model_path": "/models/Qwen3-32B",
          "command": [
            "python3",
            "-m",
            "sglang.launch_server",
            "--model-path",
            "/models/Qwen3-32B",
            "--host",
            "0.0.0.0",
            "--port",
            "30000",
            "--tp-size",
            "2",
            "--trust-remote-code",
            "--enable-hierarchical-cache",
            "--hicache-io-backend",
