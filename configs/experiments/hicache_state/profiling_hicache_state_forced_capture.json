{
  "name": "profiling_hicache_state_forced_capture",
  "framework": "sglang",
  "continue_on_error": false,
  "metadata": {
    "purpose": "Forced-token capture suite for the three manual HiCache workloads. It runs one minimal deterministic SGLang server without HiCache and publishes a suite-level forced_token_bundle.json.",
    "server_matrix_note": "Capture intentionally uses a single minimal deterministic server. HiCache is disabled because capture only fixes prompt/output token ids for later replay.",
    "input_matrix_note": "Inputs are the three manual phased workloads; bench generated input is not captured by this workload driver.",
    "model_path_note": "The current model path is /models/Qwen3-32B. Update server.model_path and server.command if the container mount changes.",
    "profile_mode": "forced_token_capture",
    "forced_token_contract": "Each experiment writes a run-local forced_token_plan.json. profile_runner aggregates selected inputs into forced_token_plans/ and forced_token_bundle.json under the capture suite directory.",
    "capture_collection_note": "Forced-token capture disables all profiling channels and HiCache; it starts a minimal deterministic server, runs the workload, and publishes a portable capture bundle."
  },
  "profiling": {
    "enabled": false,
    "channels": [],
    "debug": false,
    "torch": {
      "enabled": false
    },
    "python_probe": {
      "enabled": false,
      "probes": [],
      "targets": [],
      "state_trace": {
        "enabled": false
      }
    },
    "ld_preload": {
      "enabled": false
    }
  },
  "matrix": {
    "servers": [
      {
        "id": "capture_minimal_deterministic",
        "name": "capture_minimal_deterministic",
        "metadata": {
          "purpose": "Minimal deterministic SGLang server used only to capture forced token plans; HiCache is disabled.",
          "model_path_note": "The current model path is /models/Qwen3-32B. Update server.model_path and server.command if the container mount changes.",
          "profile_mode": "forced_token_capture",
          "hicache_enabled": false
        },
        "server": {
          "model_path": "/models/Qwen3-32B",
          "command": [
            "python3",
            "-m",
            "sglang.launch_server",
            "--model-path",
            "/models/Qwen3-32B",
            "--host",
            "0.0.0.0",
            "--port",
            "30000",
            "--tp-size",
            "2",
            "--trust-remote-code",
            "--disable-cuda-graph",
            "--attention-backend",
            "ascend",
            "--sampling-backend",
            "ascend",
            "--enable-deterministic-inference",
            "--skip-server-warmup",
            "--random-seed",
            "20260623",
            "--max-total-tokens",
            "8192"
          ],
          "ready_url": "http://127.0.0.1:30000/get_model_info",
          "ready_timeout_sec": 1800
        }
      }
    ],
    "inputs": [
      {
        "id": "manual_phased_fast",
        "name": "M1_manual_phased_fast",
        "metadata": {
          "input_class": "manual",
          "purpose": "Fast phased manual workload for seed/reuse/backup/pressure/load-back/prefetch/dirty coverage.",
          "profile_mode": "forced_token_capture",
          "forced_token_artifact": "run-local plan aggregated into suite forced_token_bundle.json"
        },
        "bench": {
          "command": [
            "python3",
            "scripts/bench/hicache_phased_workload.py",
            "--base-url",
            "http://127.0.0.1:30000",
            "--workload-id",
            "manual_phased_fast",
            "--output-dir",
            "{bench_dir}/hicache_phased_fast",
            "--warmup-requests",
            "1",
            "--seed-requests",
            "4",
            "--reuse-requests",
            "2",
            "--backup-wait-requests",
            "2",
            "--pressure-requests",
            "8",
            "--pressure-unique-prefix",
            "--reuse-after-pressure-requests",
            "1",
            "--prefetch-seed-requests",
            "2",
            "--prefetch-reuse-requests",
            "2",
            "--dirty-eviction-requests",
            "2",
            "--shared-prefix-repeat",
            "96",
            "--unique-suffix-repeat",
            "8",
            "--sleep-sec",
            "0.0",
            "--phase-wait-sec",
            "0.5",
            "--timeout-sec",
            "300",
            "--max-errors",
            "1",
            "--max-new-tokens",
            "8",
            "--sampling-seed",
            "20260623",
            "--top-p",
            "1.0",
            "--top-k",
            "1",
            "--forced-token-mode",
            "capture"
          ]
        }
      },
      {
        "id": "manual_pressure_prefetch",
        "name": "M2_manual_pressure_prefetch",
        "metadata": {
          "input_class": "manual",
          "purpose": "Higher-pressure manual workload emphasizing host cleanup, prefetch reservation, and post-pressure reuse.",
          "profile_mode": "forced_token_capture",
          "forced_token_artifact": "run-local plan aggregated into suite forced_token_bundle.json"
        },
        "bench": {
          "command": [
            "python3",
            "scripts/bench/hicache_phased_workload.py",
            "--base-url",
            "http://127.0.0.1:30000",
            "--workload-id",
            "manual_pressure_prefetch",
            "--output-dir",
            "{bench_dir}/hicache_pressure_prefetch",
            "--warmup-requests",
            "1",
            "--seed-requests",
            "6",
            "--reuse-requests",
            "3",
            "--backup-wait-requests",
            "3",
            "--pressure-requests",
            "12",
            "--pressure-unique-prefix",
            "--reuse-after-pressure-requests",
            "2",
            "--prefetch-seed-requests",
            "3",
            "--prefetch-reuse-requests",
            "3",
            "--dirty-eviction-requests",
            "3",
            "--shared-prefix-repeat",
            "128",
            "--unique-suffix-repeat",
            "12",
            "--sleep-sec",
            "0.0",
            "--phase-wait-sec",
            "1.0",
            "--timeout-sec",
            "480",
            "--max-errors",
            "1",
            "--max-new-tokens",
            "12",
            "--sampling-seed",
            "20260623",
            "--top-p",
            "1.0",
            "--top-k",
            "1",
            "--forced-token-mode",
            "capture"
          ]
        }
      },
      {
        "id": "manual_deeper_pressure_prefetch",
        "name": "M3_manual_deeper_pressure_prefetch",
        "metadata": {
          "input_class": "manual",
          "purpose": "Larger manual phased workload for deeper host pressure, longer shared prefixes, stronger prefetch reuse, and more dirty eviction coverage.",
          "profile_mode": "forced_token_capture",
          "forced_token_artifact": "run-local plan aggregated into suite forced_token_bundle.json"
        },
        "bench": {
          "command": [
            "python3",
            "scripts/bench/hicache_phased_workload.py",
            "--base-url",
            "http://127.0.0.1:30000",
            "--workload-id",
            "manual_deeper_pressure_prefetch",
            "--output-dir",
            "{bench_dir}/hicache_deeper_pressure_prefetch",
            "--warmup-requests",
            "1",
            "--seed-requests",
            "8",
            "--reuse-requests",
            "4",
            "--backup-wait-requests",
            "4",
            "--pressure-requests",
            "18",
            "--pressure-unique-prefix",
            "--reuse-after-pressure-requests",
            "3",
            "--prefetch-seed-requests",
            "4",
            "--prefetch-reuse-requests",
            "5",
            "--dirty-eviction-requests",
            "4",
            "--shared-prefix-repeat",
            "160",
            "--unique-suffix-repeat",
            "16",
            "--sleep-sec",
            "0.0",
            "--phase-wait-sec",
            "1.0",
            "--timeout-sec",
            "720",
            "--max-errors",
            "1",
            "--max-new-tokens",
            "16",
            "--sampling-seed",
            "20260623",
            "--top-p",
            "1.0",
            "--top-k",
            "1",
            "--forced-token-mode",
            "capture"
          ]
        }
      }
    ]
  }
}
