{
  "name": "profiling_smoke_ld_preload",
  "framework": "sglang",
  "profiling": {
    "enabled": true,
    "channels": ["ld_preload"],
    "debug": true,
    "torch": {
      "enabled": false
    },
    "ld_preload": {
      "enabled": true,
      "library": "build/docker/sglang/lib/libhook.so",
      "trace_output": "trace/ld_preload/cpu_trace.json"
    }
  },
  "server": {
    "command": ["python3", "-c", "import time; time.sleep(1)"],
    "ready_url": "http://127.0.0.1:30000/get_model_info"
  },
  "bench": {
    "command": ["python3", "-c", "print('bench smoke placeholder')"]
  }
}
