{
  "name": "profiling_sglang_bench_serving_base_dag",
  "framework": "sglang",
  "metadata": {
    "purpose": "Collect torch and LD_PRELOAD traces with SGLang bench_serving for faithful base DAG validation.",
    "model_path_note": "The current model path is /models/Qwen3-32B. Update server.model_path and server.command if the container mount changes."
  },
  "profiling": {
    "enabled": true,
    "channels": ["torch", "ld_preload"],
    "debug": false,
    "torch": {
      "enabled": true,
      "output_dir": "trace/torch",
      "with_stack": false,
      "record_shapes": false
    },
    "ld_preload": {
      "enabled": true,
      "library": "build/docker/sglang/lib/libhook.so",
      "trace_output": "trace/ld_preload/cpu_trace.json"
    }
  },
  "server": {
    "model_path": "/models/Qwen3-32B",
    "command": [
      "python3",
      "-m",
      "sglang.launch_server",
      "--model-path",
      "/models/Qwen3-32B",
      "--host",
      "0.0.0.0",
      "--port",
      "30000",
      "--tp-size",
      "2",
      "--trust-remote-code",
      "--disable-cuda-graph"
    ],
    "ready_url": "http://127.0.0.1:30000/get_model_info",
    "ready_timeout_sec": 1800
  },
  "bench": {
    "kind": "sglang.bench_serving",
    "args": {
      "backend": "sglang",
      "base_url": "http://127.0.0.1:30000",
      "model": "/models/Qwen3-32B",
      "tokenizer": "/models/Qwen3-32B",
      "dataset_name": "random-ids",
      "num_prompts": 32,
      "random_input_len": 256,
      "random_output_len": 32,
      "request_rate": 4,
      "max_concurrency": 4,
      "warmup_requests": 2,
      "disable_tqdm": true,
      "output_details": true
    }
  }
}
