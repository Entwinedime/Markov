{
  "name": "hicache_manual_template_capture_no_profile",
  "framework": "sglang",
  "continue_on_error": false,
  "run_root": "data/no_profile_runs/sglang",
  "metadata": {
    "purpose": "Capture one forced-token plan for each JSON workload before replay. Authoritative shapes are W1=35+12, W2=25+14, and W3=75+12 prepare+formal requests.",
    "profile_mode": "forced_token_capture",
    "model_path_note": "The fixed model is /models/Qwen3-32B; capture intentionally runs with HiCache disabled.",
    "token_contract": "Replay checks workload ID, request order, origin_input_ids, and forced_output_ids before request 1."
  },
  "profiling": {
    "enabled": false,
    "channels": [],
    "debug": false,
    "torch": {"enabled": false},
    "python_probe": {"enabled": false, "consumers": []},
    "ld_preload": {"enabled": false}
  },
  "matrix": {
    "servers": [
      {
        "id": "capture_minimal_deterministic",
        "name": "capture_minimal_deterministic",
        "server": {
          "model_path": "/models/Qwen3-32B",
          "command": [
            "python3", "-m", "sglang.launch_server", "--model-path", "/models/Qwen3-32B",
            "--host", "0.0.0.0", "--port", "30000", "--tp-size", "2", "--trust-remote-code",
            "--disable-cuda-graph", "--attention-backend", "ascend", "--sampling-backend", "ascend",
            "--enable-deterministic-inference", "--skip-server-warmup", "--random-seed", "20260729",
            "--max-total-tokens", "8192", "--chunked-prefill-size", "-1", "--max-running-requests", "1",
            "--max-prefill-tokens", "4096"
          ],
          "ready_url": "http://127.0.0.1:30000/get_model_info",
          "ready_timeout_sec": 300
        }
      }
    ],
    "inputs": [
      {
        "id": "w1_device_spill_qualification_ring",
        "bench": {
          "command": [
            "python3", "scripts/bench/hicache_template_workload.py",
            "--template", "configs/workloads/hicache_manual/w1_device_spill_qualification_ring.json",
            "--config-specs", "configs/workloads/hicache_manual/configs.json",
            "--tokenizer-path", "/models/Qwen3-32B", "--base-url", "http://127.0.0.1:30000",
            "--output-dir", "{bench_dir}/w1", "--timeout-sec", "600",
            "--forced-token-mode", "capture"
          ]
        }
      },
      {
        "id": "w2_writeback_dual_tier_cascade",
        "bench": {
          "command": [
            "python3", "scripts/bench/hicache_template_workload.py",
            "--template", "configs/workloads/hicache_manual/w2_writeback_dual_tier_cascade.json",
            "--config-specs", "configs/workloads/hicache_manual/configs.json",
            "--tokenizer-path", "/models/Qwen3-32B", "--base-url", "http://127.0.0.1:30000",
            "--output-dir", "{bench_dir}/w2", "--timeout-sec", "600",
            "--forced-token-mode", "capture"
          ]
        }
      },
      {
        "id": "w3_prefetch_admission_ladder_and_survival",
        "bench": {
          "command": [
            "python3", "scripts/bench/hicache_template_workload.py",
            "--template", "configs/workloads/hicache_manual/w3_prefetch_admission_ladder_and_survival.json",
            "--config-specs", "configs/workloads/hicache_manual/configs.json",
            "--tokenizer-path", "/models/Qwen3-32B", "--base-url", "http://127.0.0.1:30000",
            "--output-dir", "{bench_dir}/w3", "--timeout-sec", "600",
            "--forced-token-mode", "capture"
          ]
        }
      }
    ]
  }
}
