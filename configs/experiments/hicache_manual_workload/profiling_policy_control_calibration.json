{
  "name": "hicache_policy_control_calibration",
  "framework": "sglang",
  "continue_on_error": false,
  "post_workload_drain_sec": 1,
  "cleanup_hicache_storage_after_run": true,
  "sync_filesystem_after_hicache_storage_cleanup": true,
  "run_root": "data/profile_runs/sglang",
  "metadata": {
    "purpose": "One target-independent Load control calibration suite over semantic write policy and the endpoint page geometries of the current config space.",
    "profile_mode": "hicache_policy_control_calibration_real_workload_lightweight_probe",
    "calibration_role": "load_target_policy_page_control_surface",
    "calibration_workload_source": "existing_5x3_real_workload",
    "target_config_identity_used": false,
    "target_workload_trace_used": false,
    "target_e2e_used": false,
    "snapshot_free": true
  },
  "server": {
    "model_path": "/models/Qwen3-32B",
    "command": [
      "python3", "-m", "sglang.launch_server",
      "--model-path", "/models/Qwen3-32B",
      "--host", "0.0.0.0",
      "--port", "30000",
      "--tp-size", "2",
      "--trust-remote-code",
      "--enable-hierarchical-cache",
      "--hicache-io-backend", "kernel_ascend",
      "--hicache-mem-layout", "page_first_direct",
      "--hicache-storage-backend", "file",
      "--disable-cuda-graph",
      "--attention-backend", "ascend",
      "--sampling-backend", "ascend",
      "--enable-deterministic-inference",
      "--skip-server-warmup",
      "--random-seed", "20260729",
      "--numa-node", "6", "6",
      "--page-size", "{metadata.calibration_page_size}",
      "--max-total-tokens", "3584",
      "--hicache-ratio", "{metadata.calibration_hicache_ratio}",
      "--hicache-write-policy", "{metadata.calibration_write_policy}",
      "--hicache-storage-prefetch-policy", "wait_complete",
      "--hicache-storage-backend-extra-config", "{\"prefetch_threshold\":128,\"prefetch_timeout_base\":2.0,\"prefetch_timeout_per_ki_token\":0.0,\"prefetch_timeout_max\":2.0,\"hicache_storage_pass_prefix_keys\":true}",
      "--chunked-prefill-size", "-1",
      "--max-running-requests", "1",
      "--max-prefill-tokens", "4096",
      "--radix-eviction-policy", "lru",
      "--admin-api-key", "hicache-manual-diagnostic-20260729"
    ],
    "ready_url": "http://127.0.0.1:30000/get_model_info",
    "ready_timeout_sec": 300,
    "startup_max_attempts": 3,
    "startup_retry_delay_sec": 30,
    "shutdown_cooldown_sec": 20
  },
  "profiling": {
    "enabled": true,
    "channels": ["torch", "ld_preload", "python_probe"],
    "debug": false,
    "torch": {
      "enabled": true,
      "output_dir": "trace/torch",
      "activities": ["CPU", "GPU"],
      "with_stack": false,
      "record_shapes": false,
      "merge_profiles": false,
      "api_key": "hicache-manual-diagnostic-20260729"
    },
    "python_probe": {
      "flush_interval_sec": 0.25,
      "consumers": ["hicache_state_model", "hicache_input_contract", "hicache_dag_patch"],
      "flush_every": 256
    },
    "ld_preload": {
      "enabled": true,
      "library": "build/docker/sglang/lib/libhook.so",
      "trace_output": "trace/ld_preload/cpu_trace.json"
    }
  },
  "env": {
    "SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR": "{run_dir}/hicache_storage",
    "TRACE_SIM_HICACHE_DIAGNOSTIC_API_KEY": "hicache-manual-diagnostic-20260729",
    "SGLANG_SET_CPU_AFFINITY": "0",
    "SGLANG_NUMA_BIND_V2": "0",
    "SGLANG_CRASH_ON_NUMA_BIND_FAILURE": "1",
    "SGLANG_CPU_OMP_THREADS_BIND": "144-155|156-167"
  },
  "matrix": {
    "servers": [
      {
        "id": "CAL_load_control_page32_write_through",
        "metadata": {
          "calibration_page_size": 32,
          "calibration_hicache_ratio": 4.495,
          "calibration_write_policy": "write_through",
          "calibration_policy_class": "write_through_family"
        }
      },
      {
        "id": "CAL_load_control_page32_write_back",
        "metadata": {
          "calibration_page_size": 32,
          "calibration_hicache_ratio": 4.495,
          "calibration_write_policy": "write_back",
          "calibration_policy_class": "write_back"
        }
      },
      {
        "id": "CAL_load_control_page128_write_through",
        "metadata": {
          "calibration_page_size": 128,
          "calibration_hicache_ratio": 4.49,
          "calibration_write_policy": "write_through",
          "calibration_policy_class": "write_through_family"
        }
      },
      {
        "id": "CAL_load_control_page128_write_back",
        "metadata": {
          "calibration_page_size": 128,
          "calibration_hicache_ratio": 4.49,
          "calibration_write_policy": "write_back",
          "calibration_policy_class": "write_back"
        }
      }
    ],
    "inputs": [
      {
        "id": "w2_writeback_dual_tier_cascade",
        "bench": {
          "command": [
            "python3", "scripts/bench/hicache_template_workload.py",
            "--template", "configs/workloads/hicache_manual/w2_writeback_dual_tier_cascade.json",
            "--config-specs", "configs/workloads/hicache_manual/policy_control_calibration_configs.json",
            "--config-id", "{metadata.suite_server_id}",
            "--tokenizer-path", "/models/Qwen3-32B",
            "--base-url", "http://127.0.0.1:30000",
            "--output-dir", "{bench_dir}/w2",
            "--timeout-sec", "600",
            "--forced-token-mode", "replay",
            "--forced-token-plan", "{forced_token_plan}"
          ]
        }
      },
      {
        "id": "w3_prefetch_admission_ladder_and_survival",
        "bench": {
          "command": [
            "python3", "scripts/bench/hicache_template_workload.py",
            "--template", "configs/workloads/hicache_manual/w3_prefetch_admission_ladder_and_survival.json",
            "--config-specs", "configs/workloads/hicache_manual/policy_control_calibration_configs.json",
            "--config-id", "{metadata.suite_server_id}",
            "--tokenizer-path", "/models/Qwen3-32B",
            "--base-url", "http://127.0.0.1:30000",
            "--output-dir", "{bench_dir}/w3",
            "--timeout-sec", "600",
            "--forced-token-mode", "replay",
            "--forced-token-plan", "{forced_token_plan}"
          ]
        }
      }
    ]
  }
}
