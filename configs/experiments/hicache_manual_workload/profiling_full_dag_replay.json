{
  "name": "hicache_manual_template_lightweight_dag_replay",
  "framework": "sglang",
  "continue_on_error": true,
  "post_workload_drain_sec": 1,
  "cleanup_hicache_storage_after_run": true,
  "sync_filesystem_after_hicache_storage_cleanup": true,
  "run_root": "data/profile_runs/sglang",
  "metadata": {
    "purpose": "Strictly serial lightweight-probe DAG profiling replay for the HiCache manual 5-config x 3-workload panel.",
    "profile_mode": "dag_analysis_lightweight_probe_replay",
    "model_path_note": "All cells use /models/Qwen3-32B and the same capture bundle; only the declared joint HiCache config changes.",
    "forced_token_contract": "scripts/profile.sh must receive --forced-token-bundle; the runner resolves each selected input to its captured token plan before server startup.",
    "full_dag_contract": "Each completed cell must emit torch, LD_PRELOAD, and lightweight Python probe traces, preserve the workload formal window/checkpoint/forced-token replay contract, and emit no validation-only state_snapshot facts.",
    "python_probe_contract": "Only state-model, input-contract, and DAG-patch consumers exist; snapshot construction is not part of the active probe implementation.",
    "execution_contract": "NPU cells are strictly serial. Both TP ranks use the NUMA node local to physical NPU 0/1, with disjoint CPU subsets, so host-memory placement cannot drift across cells. After each server exits, run-local hicache_storage payloads are deleted and filesystem writeback is synchronized while trace/manifest/log assets are retained, preventing prior cells from changing later file-cache or writeback pressure. An accepted matrix must be one suite with planned=attempted=completed=15 and zero failures or aborts. Python probe keeps event-count batching and also flushes a partial batch every 0.25 seconds; capture channels remain active for one second after the formal workload marker. Acceptance still requires per-request lifecycle closure and does not use the fixed drain as proof. Formal E2E is unchanged.",
    "numa_binding_provenance": "npu-smi reports physical NPU 0/1 on PCIe C1:00.0/C2:00.0; host sysfs maps both devices to NUMA node 6 (CPUs 144-167)."
  },
  "profiling": {
    "enabled": true,
    "channels": [
      "torch",
      "ld_preload",
      "python_probe"
    ],
    "debug": false,
    "torch": {
      "enabled": true,
      "output_dir": "trace/torch",
      "activities": [
        "CPU",
        "GPU"
      ],
      "with_stack": false,
      "record_shapes": false,
      "merge_profiles": false,
      "api_key": "hicache-manual-diagnostic-20260729"
    },
    "python_probe": {
      "flush_interval_sec": 0.25,
      "consumers": [
        "hicache_state_model",
        "hicache_input_contract",
        "hicache_dag_patch"
      ],
      "flush_every": 256
    },
    "ld_preload": {
      "enabled": true,
      "library": "build/docker/sglang/lib/libhook.so",
      "trace_output": "trace/ld_preload/cpu_trace.json"
    }
  },
  "env": {
    "SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR": "{run_dir}/hicache_storage",
    "TRACE_SIM_HICACHE_DIAGNOSTIC_API_KEY": "hicache-manual-diagnostic-20260729",
    "SGLANG_SET_CPU_AFFINITY": "0",
    "SGLANG_NUMA_BIND_V2": "0",
    "SGLANG_CRASH_ON_NUMA_BIND_FAILURE": "1",
    "SGLANG_CPU_OMP_THREADS_BIND": "144-155|156-167"
  },
