{
  "name": "hicache_zero_payload_control_calibration",
  "id": "C5_geometry_best_effort_zero_payload_control_calibration_w1",
  "framework": "sglang",
  "run_root": "data/profile_runs/sglang",
  "cleanup_hicache_storage_after_run": true,
  "sync_filesystem_after_hicache_storage_cleanup": true,
  "post_workload_drain_sec": 1,
  "server": {
    "model_path": "/models/Qwen3-32B",
    "command": [
      "python3",
      "-m",
      "sglang.launch_server",
      "--model-path",
      "/models/Qwen3-32B",
      "--host",
      "0.0.0.0",
      "--port",
      "30000",
      "--tp-size",
      "2",
      "--trust-remote-code",
      "--enable-hierarchical-cache",
      "--hicache-io-backend",
      "kernel_ascend",
      "--hicache-mem-layout",
      "page_first_direct",
      "--hicache-storage-backend",
      "file",
      "--disable-cuda-graph",
      "--attention-backend",
      "ascend",
      "--sampling-backend",
      "ascend",
      "--enable-deterministic-inference",
      "--skip-server-warmup",
      "--random-seed",
      "20260729",
      "--numa-node",
      "6",
      "6",
      "--page-size",
      "128",
      "--max-total-tokens",
      "3584",
      "--hicache-ratio",
      "4.49",
      "--hicache-write-policy",
      "write_back",
      "--hicache-storage-prefetch-policy",
      "best_effort",
      "--hicache-storage-backend-extra-config",
      "{\"prefetch_threshold\":1024,\"prefetch_timeout_base\":2.0,\"prefetch_timeout_per_ki_token\":0.0,\"prefetch_timeout_max\":2.0,\"hicache_storage_pass_prefix_keys\":true}",
      "--chunked-prefill-size",
      "-1",
      "--max-running-requests",
      "1",
      "--max-prefill-tokens",
      "4096",
      "--radix-eviction-policy",
      "lru",
      "--admin-api-key",
      "hicache-manual-diagnostic-20260729"
    ],
    "ready_url": "http://127.0.0.1:30000/get_model_info",
    "ready_timeout_sec": 300,
    "startup_max_attempts": 3,
    "startup_retry_delay_sec": 30,
    "shutdown_cooldown_sec": 20
  },
  "bench": {
    "command": [
      "python3",
      "scripts/bench/hicache_template_workload.py",
      "--template",
      "configs/workloads/hicache_manual/w1_device_spill_qualification_ring.json",
      "--config-specs",
      "configs/workloads/hicache_manual/zero_payload_control_calibration_config.json",
      "--config-id",
      "CAL_C5_geometry_best_effort_zero_payload_control",
      "--tokenizer-path",
      "/models/Qwen3-32B",
      "--base-url",
      "http://127.0.0.1:30000",
      "--output-dir",
      "{bench_dir}/w1",
      "--timeout-sec",
      "600",
      "--forced-token-mode",
      "replay",
      "--forced-token-plan",
      "{forced_token_plan}"
    ]
  },
  "profiling": {
    "enabled": true,
    "channels": [
      "torch",
      "ld_preload",
      "python_probe"
    ],
    "debug": false,
    "torch": {
      "enabled": true,
      "output_dir": "trace/torch",
      "activities": [
        "CPU",
        "GPU"
      ],
      "with_stack": false,
      "record_shapes": false,
      "merge_profiles": false,
      "api_key": "hicache-manual-diagnostic-20260729"
    },
    "python_probe": {
      "flush_interval_sec": 0.25,
      "consumers": [
        "hicache_state_model",
        "hicache_input_contract",
        "hicache_dag_patch"
      ],
      "flush_every": 256
    },
    "ld_preload": {
      "enabled": true,
      "library": "build/docker/sglang/lib/libhook.so",
      "trace_output": "trace/ld_preload/cpu_trace.json"
    }
  },
  "env": {
    "SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR": "{run_dir}/hicache_storage",
    "TRACE_SIM_HICACHE_DIAGNOSTIC_API_KEY": "hicache-manual-diagnostic-20260729",
    "SGLANG_SET_CPU_AFFINITY": "0",
    "SGLANG_NUMA_BIND_V2": "0",
    "SGLANG_CRASH_ON_NUMA_BIND_FAILURE": "1",
    "SGLANG_CPU_OMP_THREADS_BIND": "144-155|156-167"
  },
  "metadata": {
    "purpose": "One target-independent control calibration for the Prefetch accepted-but-zero-payload terminal branch.",
    "profile_mode": "hicache_control_calibration_lightweight_probe",
    "calibration_role": "prefetch_zero_payload_finalize",
    "calibration_geometry_source": "C5 selected-base geometry",
    "calibration_policy_perturbation": "Only the Prefetch stop policy changes from timeout to best_effort so the otherwise-unseen terminal branch executes.",
    "target_config_identity_used": false,
    "target_workload_trace_used": false,
    "target_e2e_used": false,
    "snapshot_free": true,
    "suite_server_id": "C5_writeback_long_gate_timeout",
    "suite_input_id": "w1_device_spill_qualification_ring"
  }
}
