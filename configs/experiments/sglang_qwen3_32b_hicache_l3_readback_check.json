{
  "framework": "sglang",
  "name": "qwen3-32b-hicache-l3-readback-check",
  "run_id": "hicache_l3_readback_check",
  "env": {
    "ASCEND_VISIBLE_DEVICES": "0,1",
    "SGLANG_SET_CPU_AFFINITY": "1",
    "PYTORCH_NPU_ALLOC_CONF": "expandable_segments:True",
    "STREAMS_PER_DEVICE": "32",
    "HCCL_BUFFSIZE": "1536",
    "HCCL_OP_EXPANSION_MODE": "AIV",
    "PYTHONPATH": "/workspace/trace-sim/src/profiling/python_probe",
    "TRACE_SIM_PYTHON_PROBE": "1",
    "TRACE_SIM_PYTHON_PROBES": "sglang.hicache,sglang.kvcacheio",
    "TRACE_SIM_PYTHON_PROBE_KEY_MODE": "block_hash",
    "TRACE_SIM_PYTHON_PROBE_BLOCK_SIZE_TOKENS": "32",
    "TRACE_SIM_PYTHON_PROBE_MAX_KEYS_PER_EVENT": "4096",
    "TRACE_SIM_PYTHON_PROBE_OUTPUT": "/workspace/trace-sim/data/profile_runs/sglang/hicache_l3_readback_check/trace/python_probe",
    "SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR": "/workspace/trace-sim/data/profile_runs/sglang/hicache_calibration_matrix/01_c00_baseline/hicache_file"
  },
  "hook": {
    "enabled": true,
    "library": "build/docker/sglang/lib/libhook.so",
    "trace_output": "trace/cpu_trace"
  },
  "server": {
    "ready_url": "http://127.0.0.1:30001/get_model_info",
    "ready_timeout_sec": 2400,
    "command": [
      "python3",
      "-m",
      "sglang.launch_server",
      "--model-path",
      "/models/Qwen3-32B",
      "--trust-remote-code",
      "--attention-backend",
      "ascend",
      "--device",
      "npu",
      "--tp-size",
      "2",
      "--mem-fraction-static",
      "0.6",
      "--context-length",
      "1024",
      "--page-size",
      "64",
      "--enable-hierarchical-cache",
      "--hicache-ratio",
      "1.2",
      "--enable-cache-report",
      "--hicache-write-policy",
      "write_through",
      "--hicache-storage-backend",
      "file",
      "--hicache-storage-prefetch-policy",
      "wait_complete",
      "--hicache-storage-backend-extra-config",
      "{\"hicache_storage_pass_prefix_keys\": true, \"prefetch_threshold\": 64}",
      "--disable-cuda-graph",
      "--host",
      "127.0.0.1",
      "--port",
      "30001",
      "--served-model-name",
      "Qwen3-32B"
    ]
  },
  "profile": {
    "enabled": true,
    "output_dir": "trace/torch",
    "activities": [
      "CPU",
      "GPU"
    ],
    "profile_by_stage": false,
    "with_stack": false,
    "record_shapes": false,
    "merge_profiles": false,
    "profile_prefix": "qwen3_32b_hicache_l3_readback_check",
    "stop_after_workload": true,
    "start_timeout_sec": 120,
    "stop_timeout_sec": 1800,
    "strict_stop": true
  },
  "bench": {
    "command": [
      "python3",
      "scripts/bench/hicache_phased_workload.py",
      "--base-url",
      "http://127.0.0.1:30001",
      "--output-dir",
      "/workspace/trace-sim/data/profile_runs/sglang/hicache_l3_readback_check/workload",
      "--warmup-requests",
      "1",
      "--fill-requests",
      "8",
      "--pressure-requests",
      "8",
      "--reuse-requests",
      "4",
      "--reuse-again-requests",
      "4",
      "--sleep-sec",
      "0.05"
    ]
  }
}
