{
  "deployment": {
    "platform": "Ascend 910B",
    "framework": "sglang",
    "runtime": "ascend",
    "model": "/path/to/local/model",
    "dtype": "bfloat16",
    "tensor_parallel": 2
  },
  "base": {
    "configuration": {
      "page_size": 64,
      "max_total_tokens": 4096,
      "max_prefill_tokens": 4096,
      "enable_hierarchical_cache": true,
      "hicache_ratio": 1.2,
      "hicache_write_policy": "write_back",
      "hicache_io_backend": "kernel_ascend",
      "hicache_mem_layout": "page_first_direct"
    }
  },
  "workload": "workload.json",
  "targets": [
    {
      "name": "smaller_pages",
      "configuration": {
        "page_size": 32,
        "max_total_tokens": 4096,
        "max_prefill_tokens": 4096,
        "enable_hierarchical_cache": true,
        "hicache_ratio": 1.2,
        "hicache_write_policy": "write_back",
        "hicache_io_backend": "kernel_ascend",
        "hicache_mem_layout": "page_first_direct"
      }
    }
  ],
  "execution": {
    "output": "../data/prediction",
    "jobs": 1,
    "memory_limit_gib": 4,
    "kernel_cache_initial_state": "empty",
    "capture": {
      "image": "markov-sglang:ubuntu22.04",
      "devices": [0, 1],
      "memory_limit_gib": 120,
      "cpus": 16,
      "budget": {
        "starts": 2,
        "wall_sec": 600,
        "requests": 8,
        "input_tokens": 10000,
        "output_tokens": 128,
        "retained_mib": 2048
      }
    }
  },
  "performance": {
    "database": "../data/performance.sqlite",
    "sampling_budget": {
      "starts": 5,
      "wall_sec": 900,
      "requests": 64,
      "input_tokens": 20000,
      "output_tokens": 192,
      "retained_mib": 256
    }
  }
}
