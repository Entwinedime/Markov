{
  "metadata": {
    "purpose": "Consume merged profiling traces from a real profile_manifest.json and run C++ TraceGraph modeling.",
    "usage": "python3 scripts/internal/model_runner.py --config configs/modeling/modeling_hicache_from_manifest.json --profile-manifest <run_dir>/profile_manifest.json --output-dir <run_dir>/modeling/faithful_replay --mode faithful_replay --emit-validation --emit-module-summary"
  },
  "input": {},
  "output_dir": "data/modeling_runs/hicache_from_manifest",
  "mode": "cache_patch",
  "validation": {
    "faithful_replay_full_e2e_rel_error_max": 0.1,
    "faithful_replay_selected_phase_rel_error_max": 0.1,
    "cache_patch_e2e_rel_error_max": 0.2
  },
  "modules": [
    {
      "name": "HiCacheModule",
      "enabled": true,
      "config": {
        "hicache": {
          "enabled": true
        }
      }
    }
  ],
  "outputs": {
    "emit_dag_chrome_trace": false,
    "emit_module_summary": false,
    "emit_validation": false,
    "debug": false
  }
}
