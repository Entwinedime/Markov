{
  "metadata": {
    "purpose": "Predict HiCache target state from a base profiling manifest using a combined low-capacity write-back target config. This validates that capacity eviction and dirty writeback compose correctly.",
    "usage": "python3 scripts/internal/model_runner.py --config configs/modeling/hicache_state/modeling_hicache_state_prediction_write_back_capacity.json --profile-manifest <base_run_dir>/profile_manifest.json --output-dir <base_run_dir>/modeling/predict_write_back_capacity_state --mode cache_state --emit-module-summary --emit-validation --hicache-oracle-trace <target_run_dir>/modeling/cache_state_replay/merged_trace/merged_trace_00.json"
  },
  "input": {
    "target_experiment_config": "configs/experiments/hicache_state/profiling_hicache_state_write_back_capacity_validation.json"
  },
  "output_dir": "data/modeling_runs/hicache_state_prediction_write_back_capacity",
  "mode": "cache_state",
  "validation": {
    "hicache_state": {
      "enabled": true,
      "oracle_trace_paths": []
    }
  },
  "modules": [
    {
      "name": "HiCacheModule",
      "enabled": true,
      "config": {
        "hicache": {
          "enabled": true
        }
      }
    }
  ],
  "outputs": {
    "emit_dag_chrome_trace": false,
    "emit_module_summary": true,
    "emit_validation": true,
    "debug": false
  }
}
