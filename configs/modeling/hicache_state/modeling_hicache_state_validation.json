{
  "metadata": {
    "purpose": "Run C++ HiCache state-only validation from a profiling_hicache_state_validation profile manifest.",
    "usage": "python3 scripts/internal/model_runner.py --config configs/modeling/hicache_state/modeling_hicache_state_validation.json --profile-manifest <run_dir>/profile_manifest.json --output-dir <run_dir>/modeling/cache_state_replay --mode cache_state --emit-module-summary --emit-validation"
  },
  "input": {},
  "output_dir": "data/modeling_runs/hicache_state_validation",
  "mode": "cache_state",
  "validation": {
    "faithful_replay_full_e2e_rel_error_max": 0.1,
    "hicache_state": {
      "enabled": true
    }
  },
  "modules": [
    {
      "name": "HiCacheModule",
      "enabled": true,
      "config": {
        "hicache": {
          "enabled": true
        }
      }
    }
  ],
  "outputs": {
    "emit_dag_chrome_trace": false,
    "emit_module_summary": true,
    "emit_validation": true,
    "debug": false
  }
}
